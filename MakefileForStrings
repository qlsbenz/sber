CC = gcc
CFLAGS = -Wall -Wextra -Werror -std=c11

BUILD_DIR = ../../build
STRING_SRCS = s21_string.c
TEST_SRCS = s21_string.c s21_string_test.c

.PHONY: strlen_tests strcmp_tests strcpy strcat strchr strstr full_coverage_tests text_processor clean

strlen_tests:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_6

strcmp_tests:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_7

strcpy:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_8

strcat:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_9

strchr:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_10

strstr:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_11

full_coverage_tests:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_SRCS) -o $(BUILD_DIR)/Quest_12

text_processor:
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) text_processor.c s21_string.c -o $(BUILD_DIR)/Quest_13

clean:
	rm -f $(BUILD_DIR)/Quest_6 $(BUILD_DIR)/Quest_7 $(BUILD_DIR)/Quest_8 \
		$(BUILD_DIR)/Quest_9 $(BUILD_DIR)/Quest_10 $(BUILD_DIR)/Quest_11 \
		$(BUILD_DIR)/Quest_12 $(BUILD_DIR)/Quest_13
